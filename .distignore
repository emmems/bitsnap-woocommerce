# Files that stay out of the release zip (bin/build-zip.sh reads this with rsync --exclude-from).
# Patterns with a leading slash match at the repository root only.
# The compiled `build/` directory and `languages/*.mo` are produced by CI and ARE shipped.
# `/vendor` is the development copy; the zip gets its own `composer install --no-dev` vendor/ directory.
/.git
/.github
/.wordpress-org
/.editorconfig
/.eslintrc.js
/.gitattributes
/.gitignore
/.distignore
/.wp-env.json
/.phpcs-cache
/.phpunit.cache
/.phpunit.result.cache
/.idea
/.vscode
/.env*
.DS_Store
*.log
/bin
/dist
/docs
/node_modules
/tests
/vendor
/assets
/composer.json
/composer.lock
/package.json
/package-lock.json
/phpcs.xml.dist
/phpunit.xml.dist
/webpack.config.js
/CONTRIBUTING.md
/README.md
/SECURITY.md
*.zip
